<?xml version="1.0" encoding="utf-8"?>
<!-- On this day (SPEC §21.2): 4 × 2 by default, resizable from 2 × 2; no configuration. Redrawn just after midnight and on changes of the media, never by a period. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_on_this_day_desc"
    android:initialLayout="@layout/widget_on_this_day_loading"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_on_this_day_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
