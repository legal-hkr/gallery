<?xml version="1.0" encoding="utf-8"?>
<!-- On this day before its first drawing: the surface container in the launcher's rounding, with its shadow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription,UseAppTint,UseCompoundDrawables"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/widget_frame"
        android:clipToOutline="true"
        android:elevation="2dp">
    </FrameLayout>
</FrameLayout>
